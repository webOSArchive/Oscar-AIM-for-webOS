+/*
+ * webOS Chat: give an alias-less buddy its screen name as its SERVER alias (local only: unlike
+ * purple_blist_alias_buddy() this is not written back to the server-stored list). webOS's IM
+ * transport (imlibpurpleservice) leaves any buddy whose purple_buddy_get_alias_only() is NULL
+ * out of the buddy list it hands Messaging -- a filter meant for deleted Telegram users -- and
+ * OSCAR only sets a server alias when the server's formatting of a name differs from the stored
+ * one ("TouchPadTest" for "touchpadtest"), so an all-lowercase buddy like "curator" never
+ * appeared in Messaging at all.
+ */
+static void
+oscar_webos_ensure_alias(PurpleBuddy *b)
+{
+	if (b != NULL && purple_buddy_get_alias_only(b) == NULL)
+		purple_blist_server_alias_buddy(b, purple_buddy_get_name(b));
+}
