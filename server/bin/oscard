#!/usr/bin/env php
<?php
/**
 * webOS Chat's OSCAR server. Run: php bin/oscard [config.ini]
 * See ../README.md for the configuration and deployment.
 */
require_once __DIR__ . '/../src/Server.php';

$ini = $argv[1] ?? __DIR__ . '/../config.ini';
$cfg = is_file($ini) ? parse_ini_file($ini, false, INI_SCANNER_TYPED) : [];
$get = fn(string $k, $d) => getenv('OSCAR_' . strtoupper($k)) ?: ($cfg[$k] ?? $d);

$dataDir = $get('data_dir', __DIR__ . '/../data');
// accounts: "file", "pdo", or several in the order to ask them ("file,pdo").
$stores = array_map(fn($a) => match ($a) {
    'pdo' => new PdoAccounts($get('db_dsn', ''), $get('db_user', ''), $get('db_pass', '')),
    'file' => new FileAccounts("$dataDir/accounts.json"),
    default => throw new InvalidArgumentException("accounts: unknown store '$a'"),
}, array_map('trim', explode(',', $get('accounts', 'file'))));
$accounts = count($stores) === 1 ? $stores[0] : new ChainAccounts($stores);

(new Server(
    array_map('trim', explode(',', $get('listen', '0.0.0.0:5190'))),
    $get('advertise', 'oscar.webosarchive.org:5190'),
    $accounts,
    new UserData($dataDir, (int)$get('offline_max', 100), (int)$get('offline_days', 30)),
    match (strtolower((string)$get('log_level', 'normal'))) {
        'debug' => Server::LOG_DEBUG,
        'verbose' => Server::LOG_VERBOSE,
        default => Server::LOG_NORMAL,
    },
    [
        'max_conns' => $get('max_conns', null),
        'max_per_ip' => $get('max_per_ip', null),
        'signon_timeout' => $get('signon_timeout', null),
        'max_sessions' => $get('max_sessions', null),
    ],
    filter_var($get('auto_buddies', true), FILTER_VALIDATE_BOOL),
))->run();
